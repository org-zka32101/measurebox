# Firebase Configuration Example
# Copy this file to .firebase_config.env and fill in your actual values
# DO NOT commit .firebase_config.env to git (add to .gitignore)

# iOS Configuration
IOS_BUNDLE_ID=com.yourwish.measuretrackers
IOS_TEAM_ID=YOUR_TEAM_ID
IOS_SHA1=SHA1_FROM_DEVELOPER_ACCOUNT

# Android Configuration
ANDROID_PACKAGE_NAME=com.yourwish.measuretrackers
ANDROID_SHA1_DEBUG=SHA1_FROM_DEBUG_KEYSTORE
ANDROID_SHA1_RELEASE=SHA1_FROM_RELEASE_KEYSTORE

# Firebase Project
FIREBASE_PROJECT_ID=petit-works-utility
FIREBASE_PROJECT_NUMBER=YOUR_PROJECT_NUMBER
